# Your settings and keys. The app fills this in for you from its pages, so you usually never touch it.
# To set something by hand: copy this file, name the copy .env, and fill in only what you need.
# Put the value right after the = sign, with nothing else on the line.

# Which AI to use: claude, claude_key or chatgpt (the gear in the app sets this)
AI_ENGINE=

# Only for the API key option
ANTHROPIC_API_KEY=

# Analytics: your Instagram token (the Analytics page sets this)
IG_ACCESS_TOKEN=

# Save to Cleve (optional)
CLEVE_API_KEY=

# Use only one Chrome profile for the Instagram login, like: Profile 2
IG_CHROME_PROFILE=

# small is fast. medium is more accurate but slower.
WHISPER_MODEL=

# The port the app runs on (5055 if empty)
PORT=
